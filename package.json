{
  "name": "@specx/cli",
  "version": "0.1.0",
  "description": "Self-sufficient spec-driven framework from raw idea to maintained product",
  "keywords": ["specx", "specs", "cli", "ai", "sdd", "enterprise"],
  "homepage": "https://github.com/WIRIN-prod/specx",
  "repository": {
    "type": "git",
    "url": "https://github.com/WIRIN-prod/specx.git"
  },
  "license": "MIT",
  "author": "WIRIN",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "specx": "./bin/specx.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "!dist/**/*.test.js"
