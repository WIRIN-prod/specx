# Plane Community Edition - local self-host
# Copy to plane.env and fill in the blanks. See README.md for secret generation.

APP_RELEASE=v1.4.1

# --- where state lives on the host (bind mounts) -----------------------------
PLANE_DATA=./data

# --- how you reach it --------------------------------------------------------
# Port 80 is left alone so it stays free for anything else on this machine.
LISTEN_HTTP_PORT=8080
LISTEN_HTTPS_PORT=8443
APP_DOMAIN=localhost:8080
WEB_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Internal listen address of the proxy container, published to LISTEN_HTTP_PORT above.
SITE_ADDRESS=:80

DEBUG=0
API_BASE_URL=http://api:8000

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

# --- database ----------------------------------------------------------------
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
# Must stay in sync with POSTGRES_* above - the app reads this, not the parts.
DATABASE_URL=postgresql://plane:<POSTGRES_PASSWORD>@plane-db/plane

# --- redis / valkey ----------------------------------------------------------
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# --- rabbitmq ----------------------------------------------------------------
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:<RABBITMQ_PASSWORD>@plane-mq:5672/plane

# --- object storage (minio) --------------------------------------------------
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
MINIO_ENDPOINT_SSL=0

# --- secrets -----------------------------------------------------------------
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# --- tls (unused for local http) ---------------------------------------------
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0

# --- limits ------------------------------------------------------------------
GUNICORN_WORKERS=1
# specX paces itself at ~1 req/s; raise this if you fan out more agents.
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute

WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=